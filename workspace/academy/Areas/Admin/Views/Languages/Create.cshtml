@model academy.Modules.Multilingual.Entities.Language
@{
    ViewData["Title"] = "افزودن زبان جدید";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-2xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm p-8 mt-4">

    <div class="mb-8 border-b border-slate-100 pb-4">
        <h2 class="text-xl font-black text-slate-800 flex items-center gap-2">
            <i class="bi bi-plus-circle-dotted text-blue-500"></i> ثبت زبان جدید
        </h2>
    </div>

    <form asp-action="Create" method="post" class="space-y-6">
        <div asp-validation-summary="All" class="text-sm font-bold text-red-600 bg-red-50 p-4 rounded-xl mb-6 border border-red-200"></div>

        <div>
            <label asp-for="Code" class="block text-sm font-bold text-slate-700 mb-2">کد زبان <span class="text-red-500">*</span></label>
            <input asp-for="Code" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-left" dir="ltr" placeholder="مثلاً: en-US, fa-IR, ar-SA" required />
            <span asp-validation-for="Code" class="text-xs text-red-500 font-bold mt-1 block"></span>
        </div>

        <div>
            <label asp-for="DisplayName" class="block text-sm font-bold text-slate-700 mb-2">نام نمایشی <span class="text-red-500">*</span></label>
            <input asp-for="DisplayName" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3" placeholder="مثلاً: English, فارسی, العربية" required />
        </div>

        <div>
            <label asp-for="Direction" class="block text-sm font-bold text-slate-700 mb-2">جهت متن <span class="text-red-500">*</span></label>
            <select asp-for="Direction" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
                <option value="1">LTR (چپ به راست)</option>
                <option value="2">RTL (راست به چپ)</option>
            </select>
        </div>

        <div class="flex items-center gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="IsDefault" type="checkbox" class="w-5 h-5 text-blue-600 rounded" />
                <span class="text-sm font-bold text-slate-700">زبان پیش‌فرض سیستم باشد</span>
            </label>

            <label class="flex items-center gap-2 cursor-pointer">
                <input asp-for="IsActive" type="checkbox" checked class="w-5 h-5 text-emerald-600 rounded" />
                <span class="text-sm font-bold text-slate-700">فعال باشد</span>
            </label>
        </div>

        <div class="pt-6 border-t border-slate-100 flex items-center gap-3">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-black px-6 py-3 rounded-xl transition-all shadow-lg flex items-center gap-2">
                <i class="bi bi-check2-all"></i> ثبت و ذخیره
            </button>
            <a href="/Admin/Languages/Index" class="bg-slate-100 hover:bg-slate-200 text-slate-600 font-black px-6 py-3 rounded-xl transition-all flex items-center gap-2">
                انصراف
            </a>
        </div>
    </form>
</div>
